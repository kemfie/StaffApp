<Window x:Class="StaffApp.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:StaffApp"
        mc:Ignorable="d"
        Title="LoginWindow" Height="400" Width="500">
    <Grid RenderTransformOrigin="0.501,0.501">
        <TextBox HorizontalAlignment="Left" Height="28" Margin="75,124,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="364" x:Name="LoginBox"/>
        <Button Content="Вход" HorizontalAlignment="Center" Height="26" Margin="0,273,0,0" VerticalAlignment="Top" Width="164" x:Name="LoginButton" Click="LoginButton_Click"/>
        <PasswordBox HorizontalAlignment="Left" Margin="75,192,0,0" VerticalAlignment="Top" Width="364" Height="28" RenderTransformOrigin="0.504,-0.471" x:Name="PasswordBox"/>
        <Label Content="Вход в систему" HorizontalAlignment="Center" Height="29" Margin="0,64,0,0" VerticalAlignment="Top" Width="94" RenderTransformOrigin="0.506,0.532"/>
        <Label Content="Логин:" HorizontalAlignment="Left" Height="26" Margin="75,93,0,0" VerticalAlignment="Top" Width="55"/>
        <Label Content="Пароль:" HorizontalAlignment="Left" Height="25" Margin="75,162,0,0" VerticalAlignment="Top" Width="55"/>


    </Grid>
</Window>
